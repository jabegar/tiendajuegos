<%- include('partials/cabecera') %>

<% if (juegos.length == 0) { %>
 <p>No hay videojuegos disponible</p>
<% } else { %>
    <p>Hay un total de <%= juegos.length %></p>
    <table class="table table-dark">
    <thead>
        <tr>
        <th scope="col">Titulo</th>
        <th scope="col">Plataforma</th>
        <th scope="col">Precio</th>
        </tr>
    </thead>
    <tbody>
        <% juegos.forEach(j => { %>
            <tr>
                <td><%= j.titulo %></td>
                <td><%= j.plataforma %></td>
                <td><%= j.precio %></td>
            </tr>
        <% }) %>
    </tbody>
</table>
<% } %>
<%- include('partials/pie') %>